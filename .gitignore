# (NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SUPORTE_WHATSAPP). O `.env` real segue ignorado.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
